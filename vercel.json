
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/property.js": {
      "includeFiles": ["index.html"]
    }
  },
  "rewrites": [
    {
      "source": "/property/:slug",
      "destination": "/api/property?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
